{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // --- BARIS PENTING DI BWAH INI ---
    "paths": {
      "@/*": ["./src/*"]
    }
  },
"include": [
    "next-env.d.ts",
    "globals.d.ts",       // <-- TAMBAHKAN INI
    "**/*.ts",
    "**/*.tsx",
    "**/*.css",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}